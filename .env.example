# Public client configuration only. Never put service-role, sb_secret_, admin,
# SMTP or database credentials in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Requires a development build (__DEV__). Production always denies this preview.
EXPO_PUBLIC_ENABLE_MANAGER_PREVIEW=false
